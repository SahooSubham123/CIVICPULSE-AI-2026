APP_NAME=CIVICPULSE AI API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://civicpulse_api:your-password@your-project-host:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:your-admin-password@your-project-host:5432/postgres?sslmode=require
AUTO_CREATE_SCHEMA=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSL_MODE=require
DATABASE_RLS_ROLE=civicpulse_app
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER=openai
TRUSTED_FACT_SOURCE_DOMAINS=[]
GOVERNMENT_SERVICE_PORTALS={}
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MAX_MEDIA_SIZE_BYTES=10485760
POLICY_PDF_MAX_SIZE_BYTES=20971520
POLICY_PDF_MAX_PAGES=2000
POLICY_PDF_MAX_EXTRACTED_CHARS=5000000
POLICY_CHUNK_SIZE_CHARS=1600
POLICY_CHUNK_OVERLAP_CHARS=200
POLICY_MIN_SIMILARITY=0.35
POLICY_RETRIEVAL_LIMIT=5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
